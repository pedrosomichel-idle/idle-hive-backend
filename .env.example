# Supabase (Project Settings -> API)
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-aqui

# Mesma URL acima + a chave "anon/public" (não a service_role). Usadas
# pelo painel admin no navegador (app/admin) pra fazer login.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-aqui

# Stripe (Developers -> API keys / Webhooks)
STRIPE_SECRET_KEY=sk_live_ou_sk_test_aqui
STRIPE_WEBHOOK_SECRET=whsec_aqui
STRIPE_PRICE_ID=price_aqui

# Preço do "slot extra" — permite uma SEGUNDA conta IdleHive ser usada no
# mesmo dispositivo (por padrão, cada dispositivo só ativa 1 conta).
STRIPE_DEVICE_SLOT_PRICE_ID=price_aqui_tambem

# Mercado Pago — segunda forma de pagamento, com PIX/boleto/cartão
# nativos pro Brasil (o Stripe não oferece PIX). Diferente do Stripe,
# o preço vai direto na requisição, não precisa de "Price ID"
# pré-cadastrado no painel deles.
# Access Token: Suas integrações -> [sua aplicação] -> Credenciais de
# produção -> Access Token (começa com APP_USR-).
MERCADOPAGO_ACCESS_TOKEN=seu-access-token-aqui
# Suas integrações -> [sua aplicação] -> Webhooks -> Configurar
# notificação -> revela a "Assinatura secreta".
MERCADOPAGO_WEBHOOK_SECRET=sua-assinatura-secreta-aqui
MERCADOPAGO_LICENSE_PRICE_BRL=20.00
MERCADOPAGO_DEVICE_SLOT_PRICE_BRL=10.00

# URLs pra onde o Stripe Checkout redireciona depois do pagamento.
# Aponte pro seu domínio depois do deploy (ex: https://idle-panels.vercel.app)
APP_BASE_URL=http://localhost:3000

# Duração do teste grátis, em horas
TRIAL_HOURS=8

# Quantos dispositivos uma licença padrão (paga) libera
DEFAULT_MAX_DEVICES=2

# Comissão FIXA que o afiliado ganha por cada licença vendida através
# dele (em centavos — 500 = R$ 5,00). Vale pra qualquer venda, não
# importa o valor da licença.
AFFILIATE_COMMISSION_FLAT_CENTS=500

# Força quem estiver com o app abaixo dessa versão a atualizar antes de
# continuar jogando (bloqueia a grade, mostra um botão de baixar). Deixa
# em branco/comentado pra não forçar nada. Funciona independente do
# GitHub Releases/auto-updater — é só uma comparação de número de
# versão feita na checagem de licença normal, então serve de último
# recurso mesmo se algum .exe estiver com a configuração de
# atualização automática quebrada.
# MIN_APP_VERSION=1.0.15

# Base do link de indicação automático (/r/<codigo>) que o programa de
# afiliados gera sozinho. Se não definir, cai pra APP_BASE_URL.
AFFILIATE_LINK_BASE=https://idlehive.com

# Link de download do app, usado na página de indicação (/r/<codigo>)
# pro botão "Baixar o IdleHive".
NEXT_PUBLIC_DOWNLOAD_URL=https://idlehive.com/download
